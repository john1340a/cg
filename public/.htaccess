# ============================================================
#  Réécriture Apache — toutes les requêtes non-fichier passent
#  par index.php (front controller). Adapté à l'hébergement
#  mutualisé alwaysdata (Apache + mod_rewrite).
# ============================================================

# Ne pas laisser Apache servir index.php / index.html automatiquement :
# c'est le front controller (via la réécriture ci-dessous) qui décide.
DirectoryIndex disabled

<IfModule mod_rewrite.c>
    RewriteEngine On

    # embed.html doit passer par PHP (en-tête CSP frame-ancestors dynamique),
    # même si le fichier existe → on force son routage vers index.php.
    RewriteRule ^embed\.html$ index.php [QSA,L]

    # Servir directement les vrais FICHIERS existants (assets, images,
    # polices, favicon…), sans passer par PHP.
    # NB : on ne teste PAS -d (répertoire) : les dossiers comme /compte/
    # ou /admin/ doivent être routés vers index.php (sinon Apache renvoie
    # 403, le DirectoryIndex étant désactivé). Leurs routes sont gérées
    # par PageController.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tout le reste (racine, dossiers, routes API) -> index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Empêcher l'accès direct à d'éventuels fichiers sensibles
<FilesMatch "\.(env|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

# Sécurité de base
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
