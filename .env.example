# ============================================================
#  Configuration de l'application — Bourses aux Minéraux
#  Copier ce fichier en « .env » et renseigner les valeurs.
#  Le fichier .env NE DOIT JAMAIS être versionné (voir .gitignore).
# ============================================================

# --- Environnement ---
# local | production
APP_ENV=local
# URL publique de base de l'application (sans slash final)
APP_URL=http://localhost:8000
# Clé secrète aléatoire (32+ caractères) pour signer / saler certains jetons
APP_SECRET=change_moi_par_une_chaine_aleatoire_longue

# --- Base de données PostgreSQL / PostGIS ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mineralogique
DB_USER=postgres
DB_PASS=postgres

# --- SMTP (envoi des emails transactionnels) ---
# En local, laisser MAIL_ENABLED=false pour écrire les emails dans storage/logs/mails/
MAIL_ENABLED=false
SMTP_HOST=smtp-bourses-mineraux.alwaysdata.net
SMTP_PORT=587
# tls | ssl | none
SMTP_SECURITY=tls
SMTP_USER=contact@bourses-mineraux.fr
SMTP_PASS=change_moi
MAIL_FROM=contact@bourses-mineraux.fr
MAIL_FROM_NAME=Bourses aux Minéraux

# --- Intégration iframe (WordPress) ---
# Domaine(s) autorisé(s) à intégrer l'app en iframe, séparés par des espaces.
# Exemple : https://www.mineralogique.fr https://mineralogique.fr
# Laisser vide pour autoriser tout le monde (déconseillé en production).
IFRAME_ALLOWED_ORIGINS=

# --- Sécurité / limites ---
# Taille maximale d'une affiche uploadée (octets). 5 Mo par défaut.
UPLOAD_MAX_BYTES=5242880
# Tentatives de connexion autorisées par fenêtre de 15 min / IP
LOGIN_MAX_ATTEMPTS=5
# Tentatives d'inscription autorisées par heure / IP
REGISTER_MAX_ATTEMPTS=5
